CREATE DATABASE passthrough_db;
USE passthrough_db;
CREATE TABLE t1 (id INT PRIMARY KEY, a VARCHAR(20), b VARCHAR(20)) ENGINE=DuckDB;
INSERT INTO t1 VALUES (1, 'kitten', 'sitting'), (2, 'flaw', 'lawn');
CREATE TABLE t_innodb (id INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO t_innodb VALUES (1);
#
# 1. Off by default: the name is a missing stored function, as before.
#
SELECT @@global.duckdb_function_passthrough, @@session.duckdb_function_passthrough;
@@global.duckdb_function_passthrough	@@session.duckdb_function_passthrough
0	0
SELECT levenshtein(a, b) FROM t1;
ERROR 42000: FUNCTION passthrough_db.levenshtein does not exist
SET duckdb_function_passthrough = ON;
#
# 2. Passed to DuckDB, without and with SQL normalization.
#
SET duckdb_sql_normalization = OFF;
SELECT id, levenshtein(a, b) AS d FROM t1 ORDER BY id;
id	d
1	3
2	2
SET duckdb_sql_normalization = ON;
SELECT id, levenshtein(a, b) AS d FROM t1 ORDER BY id;
id	d
1	3
2	2
SELECT id FROM t1 WHERE levenshtein(a, b) > 2 ORDER BY id;
id
1
SELECT CONCAT(a, ':', levenshtein(a, b)) AS c FROM t1 ORDER BY id;
c
kitten:3
flaw:2
SELECT SUM(levenshtein(a, b)) AS total FROM t1;
total
5
#
# 3. Set operations, including one that materializes its result.
#
SELECT levenshtein(a, b) AS d FROM t1 WHERE id = 1
UNION ALL
SELECT levenshtein(b, a) FROM t1 WHERE id = 2;
d
3
2
SELECT levenshtein(a, b) AS d FROM t1 UNION SELECT levenshtein(b, a) FROM t1 ORDER BY d;
d
2
3
#
# 4. The result column is a nullable LONGTEXT: DuckDB decides the value.
#
SELECT levenshtein(a, b) AS d FROM t1 WHERE id = 1;
Catalog	Database	Table	Table_alias	Column	Column_alias	Type	Length	Max length	Is_null	Flags	Decimals	Charsetnr
def					d	251	67108864	1	Y	0	31	255
d
3
#
# 5. A DuckDB macro, standing in for an extension function.
#
CALL dbms_duckdb.query("CREATE TEMP MACRO pt_twice(x) AS x * 2");
RESULT
Count	
BIGINT	
[ Rows: 0]


SELECT id, pt_twice(id) AS twice FROM t1 ORDER BY id;
id	twice
1	2
2	4
#
# 6. Unknown to DuckDB as well: DuckDB reports it.
#
SELECT no_such_function(a) FROM t1;
ERROR HY000: [DuckDB] Catalog Error: Scalar Function with name no_such_function does not exist!
#
# 7. Statements MySQL executes keep the usual error.
#
SELECT levenshtein('kitten', 'sitting');
ERROR 42000: FUNCTION passthrough_db.levenshtein does not exist
SELECT levenshtein(id, id) FROM t_innodb;
ERROR 42000: FUNCTION passthrough_db.levenshtein does not exist
#
# 8. A schema-qualified name is a stored function, as before.
#
SELECT passthrough_db.levenshtein(a, b) FROM t1;
ERROR 42000: FUNCTION passthrough_db.levenshtein does not exist
#
# 9. An existing stored function of that name is resolved as before.
#
CREATE FUNCTION levenshtein(x VARCHAR(20), y VARCHAR(20)) RETURNS INT DETERMINISTIC RETURN 42;
SELECT levenshtein(a) FROM t1;
ERROR 42000: Incorrect number of arguments for FUNCTION passthrough_db.levenshtein; expected 2, got 1
DROP FUNCTION levenshtein;
#
# 10. Prepared statement with a parameter, executed twice.
#
PREPARE s FROM 'SELECT id, levenshtein(a, ?) AS d FROM t1 ORDER BY id';
SET @x = 'sitting';
EXECUTE s USING @x;
id	d
1	3
2	7
SET @x = 'lawn';
EXECUTE s USING @x;
id	d
1	5
2	2
DEALLOCATE PREPARE s;
#
# 11. An account with SELECT only: no EXECUTE privilege is needed.
#
CREATE USER pt_reader@localhost;
GRANT SELECT ON passthrough_db.t1 TO pt_reader@localhost;
SET duckdb_function_passthrough = ON;
SET duckdb_sql_normalization = ON;
SELECT id, levenshtein(a, b) AS d FROM t1 ORDER BY id;
id	d
1	3
2	2
DROP USER pt_reader@localhost;
#
# 12. No default database.
#
SET duckdb_function_passthrough = ON;
SET duckdb_sql_normalization = ON;
SELECT id, levenshtein(a, b) AS d FROM passthrough_db.t1 ORDER BY id;
id	d
1	3
2	2
SELECT levenshtein('kitten', 'sitting');
ERROR 3D000: No database selected
SET duckdb_function_passthrough = OFF;
SELECT levenshtein(a, b) FROM passthrough_db.t1;
ERROR 3D000: No database selected
#
# 13. Turned off again: as before.
#
SET duckdb_function_passthrough = OFF;
SELECT levenshtein(a, b) FROM t1;
ERROR 42000: FUNCTION passthrough_db.levenshtein does not exist
SET duckdb_sql_normalization = DEFAULT;
SET duckdb_function_passthrough = DEFAULT;
DROP DATABASE passthrough_db;
