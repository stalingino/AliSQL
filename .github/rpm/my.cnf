# AliSQL server and client configuration. Package upgrades keep local changes.

[mysqld]
basedir = /opt/alisql
datadir = /var/lib/alisql
socket = /var/lib/alisql/mysql.sock
pid-file = /run/alisql/mysqld.pid
log-error = /var/log/alisql/mysqld.log

# DuckDB reads an unlimited cgroup (systemd services, containers) as 0 bytes and then fails
# every query with Out of Memory, so give it an explicit limit sized for this host.
duckdb_memory_limit = 4G
#duckdb_mode = ON

[client]
socket = /var/lib/alisql/mysql.sock
